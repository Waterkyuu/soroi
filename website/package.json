{
	"name": "soroi-docs",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"prepare:docs": "node scripts/prepare-docs.mts",
		"start": "pnpm prepare:docs && astro dev",
		"build": "pnpm prepare:docs && astro build && go run ./search-index -build build -base-path /soroi",
		"serve": "astro preview",
		"test": "node --test scripts/*.test.mts && go test -race ./search-index",
		"lint": "oxlint --deny-warnings .",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check .",
		"typecheck": "astro check && tsc --noEmit",
		"test:build": "node --test tests/*.test.mts"
	},
	"dependencies": {
		"@astrojs/react": "7.1.0",
		"@astrojs/starlight": "0.42.6",
		"astro": "7.4.2",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"typescript": "6.0.3"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.10.0"
}
